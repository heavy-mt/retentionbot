MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_SERVER_NAME=matrix.example.org
BOT_USER_ID=@retention:matrix.example.org
# Generate a hex password (openssl rand -hex 32); hex avoids AMQP URI escaping problems.
RABBITMQ_PASSWORD=replace_with_random_hex_password
DEFAULT_RETENTION=7d
DEVICE_TRUST=tofu
POLL_SECONDS=5
DISCOVER_SECONDS=60
MEDIA_GRACE_SECONDS=60
ROOM_ADMIN_POWER_LEVEL=100
# Set true after applying deploy/synapse-retention.yaml.example and restarting Synapse.
NATIVE_RETENTION_DISABLED=false
