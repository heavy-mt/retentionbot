# Direct private client listener of Synapse with the module installed.
SYNAPSE_URL=http://matrix-synapse:8008
SYNAPSE_NETWORK=matrix_net
# Separate random hex passwords, e.g. openssl rand -hex 32.
RABBITMQ_PASSWORD=replace_with_random_hex_password
DATABASE_PASSWORD=replace_with_another_random_hex_password
POLL_SECONDS=1
REFRESH_SECONDS=60
BATCH_SIZE=1000
