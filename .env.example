MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_SERVER_NAME=matrix.example.org
BOT_USER_ID=@retention:matrix.example.org
# Use separate random hex passwords (openssl rand -hex 32).
RABBITMQ_PASSWORD=replace_with_random_hex_password
DATABASE_PASSWORD=replace_with_another_random_hex_password
# Absolute path to the actual retention-containing config loaded by Synapse.
SYNAPSE_RETENTION_CONFIG_PATH=/opt/synapse/retention.yaml
DEVICE_TRUST=tofu
POLL_SECONDS=1
DISCOVER_SECONDS=60
REDACTION_LEAD_SECONDS=300
MEDIA_GRACE_SECONDS=60
ROOM_ADMIN_POWER_LEVEL=100
