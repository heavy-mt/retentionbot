FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/data
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libolm3 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir '.[bot]' && useradd --uid 10001 --create-home retention \
    && mkdir /data && chown retention:retention /data
USER 10001:10001
ENTRYPOINT ["retentionbot"]
CMD ["command-bot"]
