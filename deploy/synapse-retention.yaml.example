# Keep native retention enabled. This must be a config file actually loaded by Synapse,
# not an independent copy of its settings. Mount the same file read-only into the gateway.
# Room policies and existing settings are preserved; values below are examples.
retention:
  enabled: true
  default_policy:
    min_lifetime: 1h
    max_lifetime: 7d
  allowed_lifetime_min: 1h
  allowed_lifetime_max: 30d
  purge_jobs:
    - interval: 1h

# Optional: promptly scrub the contents of redacted events in the background.
redaction_retention_period: 0
